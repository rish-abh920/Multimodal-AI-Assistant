# Multimodal AI Assistant Environment Configuration

# Server Settings
APP_ENV=development
APP_NAME="Multimodal AI Assistant"
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Hardware & Compute Configuration
# Options: "auto", "cpu", "cuda"
DEVICE=auto
CPU_NUM_THREADS=4
LAZY_LOAD_MODELS=True
MAX_LOADED_MODELS=2

# Model Identifier Configurations
IMAGE_CAPTION_MODEL_ID=Salesforce/blip-image-captioning-base
IMAGE_VQA_MODEL_ID=dandelin/vilt-b32-finetuned-vqa
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TEXT_SUMMARIZATION_MODEL_ID=google/flan-t5-small
TEXT_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Storage & File Security
TEMP_STORAGE_DIR=data/temp
MAX_UPLOAD_IMAGE_SIZE_MB=10
MAX_UPLOAD_AUDIO_SIZE_MB=25
MAX_UPLOAD_DOC_SIZE_MB=15
CLEANUP_TEMP_FILES=True

